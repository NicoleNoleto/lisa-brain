# Database Connection
# Para Supabase: https://seu-projeto.supabase.co
# Para PostgreSQL direto: postgresql://user:password@host:port/database
VITE_SUPABASE_URL=https://your-project.supabase.co

# API Key para acesso público
# Supabase: obtém em Project Settings > API Keys > anon public
# Padrão: começa com "sb_publishable_"
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
